{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "francoromeu-app.vercel.app" }
      ],
      "destination": "https://www.francoromeufr.com.br/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sobre", "destination": "/index.html" },
    { "source": "/ambientes", "destination": "/index.html" },
    { "source": "/projetos-3d", "destination": "/index.html" },
    { "source": "/portfolio", "destination": "/index.html" },
    { "source": "/orcamento", "destination": "/index.html" }
  ]
}
