{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "francoromeu-app.vercel.app"
        }
      ],
      "destination": "https://www.francoromeufr.com.br/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sobre",
      "destination": "/"
    },
    {
      "source": "/ambientes",
      "destination": "/"
    },
    {
      "source": "/projetos-3d",
      "destination": "/"
    },
    {
      "source": "/portfolio",
      "destination": "/"
    },
    {
      "source": "/orcamento",
      "destination": "/"
    }
  ]
}
